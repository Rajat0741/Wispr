# Database Connections (Supabase Postgres via Drizzle)
DATABASE_URL= # Pooled connection string (Session/Transaction pooler) for app runtime
DIRECT_DB_URL= # Direct connection string (port 5432) required for Drizzle Kit migrations

# Supabase Realtime & API Keys
NEXT_PUBLIC_SUPABASE_URL= # Project URL
NEXT_PUBLIC_PUBLISHABLE_KEY= # Publishable public API key
SUPABASE_SECRET_KEY= # Service Role secret key (server-side only)
SUPABASE_JWT_SECRET= # Supabase project's JWT secret (server-side only)

# Better Auth Configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
